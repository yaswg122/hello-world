pipeline {
    agent any
    stages {
        stage('Build and Maven') {
            steps {
                withMaven(globalMavenSettingsConfig: '', jdk: 'jdk11', maven: 'Maven 3.8.6', mavenSettingsConfig: '', traceability: true) {
                    sh 'mvn clean install'
                }
            }
        }
    }
}
